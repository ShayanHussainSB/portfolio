{
  "name": "shayan-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Personal portfolio of Shayan M Hussain: a scroll-driven 3D flight down the request path, with every project running live in the browser.",
  "author": "Shayan M Hussain (https://github.com/ShayanHussainSB)",
  "homepage": "https://shayan.jointops.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShayanHussainSB/portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/ShayanHussainSB/portfolio/issues"
  },
  "keywords": [
    "portfolio",
    "react",
    "threejs",
    "webgl",
    "vite",
    "vercel",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"api/**/*.ts\" \"scripts/**/*.mjs\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"api/**/*.ts\" \"scripts/**/*.mjs\" vite.config.ts",
    "check": "bun run typecheck && bun run test && bun run format:check"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@joint-ops/hitlimit": "1.5.0",
    "@joint-ops/kaput": "0.1.0",
    "@noble/hashes": "2.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "bunway": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6",
    "prettier": "3.3.3",
    "typescript": "5.9",
    "vite": "8",
    "vitest": "5"
  }
}
